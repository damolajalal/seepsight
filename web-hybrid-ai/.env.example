# Firebase web app identifiers (not service-account secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=seepsight-hybrid-ai
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# reCAPTCHA Enterprise site key registered for the exact production domain.
VITE_FIREBASE_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development only. Never enable in production or commit debug tokens.
VITE_FIREBASE_APPCHECK_DEBUG=false
